# Copy this file to ".env" and fill in the values from Supabase:
# Project Settings -> API Keys.
# Use ONLY the public key (publishable "sb_publishable_..." or legacy "anon").
# NEVER put the service_role / secret key here or anywhere in this project.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
